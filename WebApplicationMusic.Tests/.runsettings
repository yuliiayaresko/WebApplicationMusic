<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat code coverage">
				<Configuration>
					<Format>cobertura</Format>
					<Exclude>
						[WebApplicationMusic]WebApplicationMusic.Pages.*
						[WebApplicationMusic]WebApplicationMusic.Pages.Pages_*
						[WebApplicationMusic]Program
					</Exclude>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
